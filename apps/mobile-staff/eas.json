{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://pos-preview-api.enablebrain.com/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://pos-preview-api.enablebrain.com",
        "EXPO_PUBLIC_WEB_URL": "https://pos-preview.enablebrain.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://pos-preview-api.enablebrain.com/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://pos-preview-api.enablebrain.com",
        "EXPO_PUBLIC_WEB_URL": "https://pos-preview.enablebrain.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://pos-preview-api.enablebrain.com/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://pos-preview-api.enablebrain.com",
        "EXPO_PUBLIC_WEB_URL": "https://pos-preview.enablebrain.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
