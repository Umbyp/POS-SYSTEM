# ===== POS Mobile Staff App (apps/mobile-staff) =====
# EXPO_PUBLIC_* vars are inlined at build/bundle time (same convention as
# apps/web's NEXT_PUBLIC_*). Copy to .env and fill in for local dev.

# URL of the POS API — same backend apps/web talks to, must end in /api
EXPO_PUBLIC_API_URL="http://localhost:4000/api"

# (optional) Socket.io realtime URL — no /api suffix. Auto-derived from
# EXPO_PUBLIC_API_URL if not set.
# EXPO_PUBLIC_SOCKET_URL="http://localhost:4000"

# Base URL of the customer-facing web app (apps/web) — used to build the
# table QR link shown in "ดู QR โต๊ะ". Defaults to http://localhost:3000.
# EXPO_PUBLIC_WEB_URL="https://order.restropos.th"

# iOS OAuth client ID from Google Cloud Console, needed for "Sign in with
# Google" (custom dev client / EAS build only — does not work in Expo Go).
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
